{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunogama/FakeryData/schema/source-evidence.schema.json",
  "title": "Fakery source evidence registry",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "url", "retrievedOn"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "url": {"type": "string", "minLength": 1},
          "retrievedOn": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
