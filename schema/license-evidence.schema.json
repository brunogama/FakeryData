{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunogama/FakeryData/schema/license-evidence.schema.json",
  "title": "Fakery license evidence registry",
  "type": "object",
  "required": ["schemaVersion", "licenses"],
  "properties": {
    "schemaVersion": {"const": 1},
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "spdxId", "evidenceUrl"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "spdxId": {"type": "string", "minLength": 1},
          "evidenceUrl": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
